# =============================================================================
# Discord 設定
# =============================================================================

# BotのトークンはDiscord Developer Portalで取得
DISCORD_TOKEN=your_discord_bot_token_here

# 要件定義を行う対象チャンネルのID
DISCORD_CHANNEL_ID=your_channel_id_here

# 管理者（Bot利用を許可するユーザー）のDiscord User ID
DISCORD_ADMIN_USER_ID=your_user_id_here

# =============================================================================
# Ollama 設定
# =============================================================================

# OllamaサーバーのURL（デフォルト: http://localhost:11434）
OLLAMA_HOST=http://localhost:11434

# Ollama APIのタイムアウト（ミリ秒）
OLLAMA_TIMEOUT_MS=30000

# Ollamaのリトライ回数（接続失敗時）
OLLAMA_RETRY_COUNT=2

# 各AIロールで使用するモデル名（Ollamaにプルされているモデル名を指定）
MODEL_DIRECTOR=llama3
MODEL_REQUIREMENTS_WRITER=llama3
MODEL_REVIEWER=llama3

# =============================================================================
# セッション制御
# =============================================================================

# 1セッションの最大ラウンド数（この数に達すると強制確定）
MAX_ROUNDS=10

# 人間の回答後に同じ論点で再質問が出た場合のAI内部協議の最大試行回数
MAX_INTERNAL_DELIBERATION=2

# =============================================================================
# 表示設定
# =============================================================================

# 3AI間の議論をリアルタイムでDiscordに投稿するか（true/false）
# true にすると指示役・要件定義役・レビュー役の発言が 🗣️ 付きで投稿される
SHOW_AI_DISCUSSION=false

# =============================================================================
# DB設定
# =============================================================================

# SQLiteのDBファイルパス（phase1-requirements-botからの相対パス）
DB_PATH=./data/bot.db
